# =============================================================================
# DJANGO .gitignore
# =============================================================================

# ── Entorno virtual ──────────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Variables de entorno ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST

# ── Django ───────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# */migrations/*.py
# !*/migrations/__init__.py

/staticfiles/
/static_root/
/media/

# ── Caché ────────────────────────────────────────────────────────────────────
.cache/
*.cache

# ── Cobertura de tests ───────────────────────────────────────────────────────
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/
nosetests.xml

# ── Jupyter Notebooks ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs y editores ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
\#*\#
.\#*

# ── Sistema operativo ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml
.dockerignore

# ── Celery ───────────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Documentación generada ───────────────────────────────────────────────────
docs/_build/
site/

# ── Archivos de secretos y claves ────────────────────────────────────────────
*.pem
*.key
*.p12
secrets.json
